# ==================================================================================
# agda-deans-problem: .gitignore
# ==================================================================================

# -- Editor and OS -----------------------------------------------------------------
*~
.#*
\#*\#
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# -- Agda build artifacts ----------------------------------------------------------
*.agdai
_build/
# The generated module index (regenerated by the Makefile).
src/EverythingDeansProblem.agda

# -- Nix and the two library dependencies ------------------------------------------
# Project-local AGDA_DIR (written fresh by `nix develop`).
/.agda/
# The writable copies of the pinned agda-algebras and agda-lattices sources
# (written by `nix develop`).
/.deps/
/result
/result-*
.direnv/

# -- Merge-conflict leftovers ------------------------------------------------------
*.orig
